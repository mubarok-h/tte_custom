[Unit]
Description=TTE STIT Buntet Pesantren
After=network.target

[Service]
Type=simple
User=tte
Group=tte
WorkingDirectory=/opt/tte
ExecStart=/opt/tte/.venv/bin/uvicorn tte_core.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
# Batasi akses tulis hanya ke data aplikasi
ReadWritePaths=/opt/tte/data

[Install]
WantedBy=multi-user.target
