# --- Aplikasi ---
TTE_ROLES=all
TTE_INSTITUTION=STIT Buntet Pesantren
TTE_LOCATION=Buntet Pesantren
TTE_PUBLIC_BASE_URL=http://localhost:8000
TTE_VERIFY_BASE_URL=http://localhost:8000

# --- Database ---
# Dev lokal:
TTE_DATABASE_URL=sqlite:///./data/tte.db
# Produksi (docker):
# TTE_DATABASE_URL=postgresql+psycopg://tte:tte@postgres:5432/tte

TTE_DATA_DIR=./data

# --- Token verifikasi (ganti di produksi) ---
TTE_TOKEN_SECRET=ganti-dengan-rahasia-panjang-acak

# --- Sertifikat & kunci ---
TTE_SIGNING_P12=./data/pki/rektor.p12
TTE_SIGNING_P12_PASSPHRASE=changeit
# Produksi dengan HSM (Nitrokey HSM 2):
# TTE_PKCS11_LIB=/usr/lib/x86_64-linux-gnu/opensc-pkcs11.so
# TTE_PKCS11_KEY_LABEL=Rektor STIT Buntet Pesantren
# TTE_PKCS11_CERT_LABEL=Rektor STIT Buntet Pesantren
TTE_ROOT_CA_PATH=./data/pki/root.crt
TTE_INTERMEDIATE_CA_PATH=./data/pki/intermediate.crt
TTE_CRL_PATH=./data/pki/crl/stit.crl
TTE_ROOT_CRL_PATH=./data/pki/crl/root.crl

# --- Timestamp (RFC 3161) ---
TTE_TSA_ENABLED=false
TTE_TSA_REQUIRED=false
# B-LT: embed chain + revocation info. Perlu trust root TSA di validation context.
TTE_EMBED_LTV=false
TTE_TSA_URLS=http://timestamp.digicert.com,http://timestamp.sectigo.com
TTE_TSA_TIMEOUT=10
TTE_TSA_ROOTS_DIR=./data/pki/tsa

# --- Batas upload ---
TTE_MAX_UPLOAD_BYTES=26214400
TTE_MAX_PAGES=500

# --- Kebijakan ---
TTE_RETENTION_YEARS=5
TTE_ENABLE_MULTISIGN=false

# --- Auth sederhana (placeholder MFA) ---
TTE_REQUIRE_AUTH=false
TTE_ADMIN_TOKEN=ganti-token-admin
